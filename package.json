{
  "name": "monastic-economies",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data/index.ts",
    "data:sample": "tsx scripts/build-data/index.ts --data fixtures",
    "data:placeholder-index": "tsx scripts/make-placeholder-index.ts",
    "dev": "npm run data && nuxt dev",
    "dev:sample": "npm run data:sample && nuxt dev",
    "generate": "npm run data && nuxt generate",
    "generate:sample": "npm run data:sample && nuxt generate",
    "preview": "npx serve .output/public",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/caladea": "^5.3.0",
    "graphology": "^0.26.0",
    "lucide-vue-next": "1.0.0",
    "maplibre-gl": "^5.24.1",
    "nuxt": "^4.6.4",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
